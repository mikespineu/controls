{
  "name": "poster-wall-controls",
  "version": "0.0.2",
  "description": "Custom React Three Fiber camera controls for interactive poster wall planners.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:example": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.150"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "keywords": [
    "react-three-fiber",
    "r3f",
    "three.js",
    "camera",
    "controls",
    "poster",
    "wall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikespineu/poster-wall-controls.git"
  },
  "homepage": "https://mikespineu.github.io/poster-wall-controls/",
  "bugs": {
    "url": "https://github.com/mikespineu/poster-wall-controls/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
